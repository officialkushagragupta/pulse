# knowledge-base-mcp-server config. Prefix KNOWLEDGE_BASE_MCP_SERVER_.
KNOWLEDGE_BASE_MCP_SERVER_OLLAMA_BASE_URL=http://localhost:11434
KNOWLEDGE_BASE_MCP_SERVER_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_BASE_MCP_SERVER_KB_DIR=data/kb
KNOWLEDGE_BASE_MCP_SERVER_INDEX_DIR=data/index
KNOWLEDGE_BASE_MCP_SERVER_CHUNK_TOKENS=400
KNOWLEDGE_BASE_MCP_SERVER_CHUNK_OVERLAP=40
KNOWLEDGE_BASE_MCP_SERVER_PORT=8100
KNOWLEDGE_BASE_MCP_SERVER_LOG_LEVEL=INFO
# Optional: set to export OpenTelemetry spans (OTLP/HTTP). Unset = no export (dev).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
