# tools-service config. Variables are prefixed TOOLS_SERVICE_ (pydantic-settings env_prefix).
TOOLS_SERVICE_POSTGRES_DSN=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
TOOLS_SERVICE_PORT=8000
TOOLS_SERVICE_LOG_LEVEL=INFO
# Optional: set to export OpenTelemetry spans (OTLP/HTTP). Unset = no export (dev).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
